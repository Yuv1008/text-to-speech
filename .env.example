# Copy this file to .env in the project root and fill in what you need.
# The app runs end-to-end with zero keys — TTS_PROVIDER defaults to the offline mock.

# ---- Server ---------------------------------------------------------------

# Environment mode. development | production
NODE_ENV=development

# Port the Express server listens on. (5000 is avoided on purpose — macOS
# Control Center/AirPlay Receiver squats on it by default.)
PORT=5050

# Origin allowed to call the API (CORS). Must match where the client is served from.
CLIENT_ORIGIN=http://localhost:5173

# ---- Client (read by Vite from this same root file, see client/vite.config.js) ----

# Base URL the client uses to reach the API. Point this at your deployed
# server origin in production (e.g. https://your-api.onrender.com/api).
VITE_API_URL=http://localhost:5050/api

# ---- TTS provider ----------------------------------------------------------

# Which adapter synthesizes speech: mock | google | elevenlabs
# mock is fully offline and requires no key — it's the default for a fresh clone.
TTS_PROVIDER=mock

# Required only when TTS_PROVIDER=google.
# API key for the Google Cloud Text-to-Speech REST API.
GOOGLE_TTS_API_KEY=

# Required only when TTS_PROVIDER=elevenlabs.
# API key for the ElevenLabs REST API.
ELEVENLABS_API_KEY=

# Optional. ElevenLabs model id override.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ---- Storage & lifecycle ----------------------------------------------------

# SQLite file used for generation history, relative to server/.
DB_PATH=./db/history.sqlite

# Directory generated audio files are written to, relative to server/.
AUDIO_DIR=./tmp/audio

# Age (in minutes) after which the janitor deletes a generated audio file.
AUDIO_TTL_MINUTES=30

# How often (in minutes) the janitor sweep runs.
JANITOR_INTERVAL_MINUTES=5

# Most-recent history rows kept in SQLite; older rows are pruned.
HISTORY_LIMIT=100

# ---- Validation & rate limiting ---------------------------------------------

# Max characters accepted per synthesis request.
MAX_TEXT_LENGTH=1000

# Rate limit window (ms) and max requests per IP within it, applied to POST /api/tts.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10
